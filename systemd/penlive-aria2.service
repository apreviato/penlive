[Unit]
Description=PenLive aria2 download engine (JSON-RPC)
After=network.target local-fs.target penlive-expand.service penlive-storage.service
RequiresMountsFor=/data/images/.downloads

[Service]
Type=exec
User=penlive
Group=penlive
ExecStartPre=/usr/bin/mkdir -p /data/images/.downloads
ExecStartPre=/usr/bin/touch /data/images/.downloads/aria2.session
# Its own service, not a child of the API: a download must survive an API
# restart or crash. app/services/downloader.resume_watchers() re-attaches to
# whatever is still running here on the next API startup.
#
# RPC is bound to loopback with no secret because the socket is unreachable
# from outside the machine and the only local account that could reach it is
# the same unprivileged user that owns the downloads.
ExecStart=/usr/bin/aria2c \
    --enable-rpc \
    --rpc-listen-all=false \
    --rpc-listen-port=6800 \
    --dir=/data/images/.downloads \
    --continue=true \
    --max-concurrent-downloads=2 \
    --max-connection-per-server=4 \
    --split=4 \
    --auto-file-renaming=false \
    --allow-overwrite=true \
    --file-allocation=none \
    --max-tries=0 \
    --retry-wait=5 \
    --connect-timeout=15 \
    --timeout=60 \
    --input-file=/data/images/.downloads/aria2.session \
    --save-session=/data/images/.downloads/aria2.session \
    --save-session-interval=30
Restart=always
RestartSec=2
# aria2 asked to stop with transfers running can take a long time to wind its
# connections down, and systemd's default is to wait 90 seconds before it
# insists. Shutdown happens with the kiosk already gone, so that wait is 90
# seconds of bare grey screen after the user pressed Shut down. Resuming is
# what the .aria2 control files beside each partial file are for, so being
# killed here costs nothing.
TimeoutStopSec=10
KillMode=mixed

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/data /var/log/penlive
ProtectHome=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
