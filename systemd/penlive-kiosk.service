[Unit]
Description=PenLive kiosk UI (X + Chromium)
After=penlive-api.service
Wants=penlive-api.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=penlive
Group=penlive
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
# kiosk.sh polls /api/health before launching Chromium, so a slow API start
# shows nothing rather than a browser error page.
ExecStart=/opt/penlive/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
