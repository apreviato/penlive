[Unit]
Description=PenLive kiosk UI (X + Chromium)
# X owns tty1 and the DRM device.  Wait until Plymouth has completely released
# both before starting it; without this ordering the two race during boot and
# X can enter the service's restart loop on slower real hardware.
After=penlive-api.service systemd-user-sessions.service systemd-logind.service
After=getty@tty1.service
After=plymouth-quit.service plymouth-quit-wait.service
Wants=penlive-api.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=penlive
Group=penlive
Environment=HOME=/var/lib/penlive
Environment=XAUTHORITY=/var/lib/penlive/.Xauthority
RuntimeDirectory=penlive-kiosk
RuntimeDirectoryMode=0700
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
# Chromium starts on a local PenLive loading page and moves to the manager when
# /api/health is ready, so a slow API never exposes a browser error page.
ExecStart=/opt/penlive/kiosk.sh
Restart=always
RestartSec=3
# X holding tty1 can be slow to release it, and the restart loop in
# xsession.sh has to be torn down with it. Bound this tightly: persistent data
# is flushed before the transition, and a wedged browser should not extend the
# blank-screen interval.
TimeoutStopSec=3
KillMode=mixed

[Install]
WantedBy=multi-user.target
