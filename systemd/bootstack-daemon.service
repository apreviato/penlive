[Unit]
Description=BootStack privileged daemon (mount, boot state, kexec, USB write)
Documentation=file:///opt/bootstack/docs/ARCHITECTURE.md
DefaultDependencies=no
After=local-fs.target
Before=bootstack-api.service

[Service]
Type=exec
# Runs as root by necessity, but its entire API is the fixed command set in
# app/daemon/protocol.py ALLOWED_COMMANDS — it never evaluates arbitrary input.
ExecStart=/opt/bootstack/venv/bin/python -m app.daemon
WorkingDirectory=/opt/bootstack/backend
Environment=PYTHONPATH=/opt/bootstack/backend:/opt/bootstack/builder
Environment=BOOTSTACK_SOCKET_GROUP=bootstack
RuntimeDirectory=bootstack
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2

# Hardening: the daemon legitimately needs mount/reboot/raw-disk access, so the
# usual ProtectSystem/PrivateDevices knobs would break it. These are the ones
# that still apply without blocking its actual job.
NoNewPrivileges=no
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
