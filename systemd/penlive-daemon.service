[Unit]
Description=PenLive privileged daemon (mount, boot state, kexec, USB write)
Documentation=file:///opt/penlive/docs/ARCHITECTURE.md
DefaultDependencies=no
After=local-fs.target penlive-storage.service
Before=penlive-api.service

[Service]
Type=exec
# Runs as root by necessity, but its entire API is the fixed command set in
# app/daemon/protocol.py ALLOWED_COMMANDS — it never evaluates arbitrary input.
ExecStart=/opt/penlive/venv/bin/python -m app.daemon
WorkingDirectory=/opt/penlive/backend
Environment=PYTHONPATH=/opt/penlive/backend:/opt/penlive/builder
Environment=PENLIVE_SOCKET_GROUP=penlive
RuntimeDirectory=penlive
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillMode=mixed

# Hardening: the daemon legitimately needs mount/reboot/raw-disk access, so the
# usual ProtectSystem/PrivateDevices knobs would break it. These are the ones
# that still apply without blocking its actual job.
NoNewPrivileges=no
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
