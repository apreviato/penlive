[Unit]
Description=BootStack Manager API (FastAPI)
After=network.target bootstack-daemon.service bootstack-aria2.service local-fs.target
Wants=bootstack-aria2.service

[Service]
Type=exec
User=bootstack
Group=bootstack
# Unprivileged on purpose: this process parses untrusted input (catalog JSON,
# ISO internals), so anything privileged is delegated to bootstack-daemon over
# its Unix socket. Bound to loopback — the UI is a local Chromium kiosk.
ExecStart=/opt/bootstack/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 7777
WorkingDirectory=/opt/bootstack/backend
Environment=PYTHONPATH=/opt/bootstack/backend:/opt/bootstack/builder
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/data /boot /var/lib/bootstack /var/log/bootstack
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
