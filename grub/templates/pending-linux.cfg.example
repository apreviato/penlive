# Reference only — the real file is generated by
# manager/backend/app/services/bootmanager.py and written to
# /boot/state/nextboot.cfg. This is what the "linux" boot method (used by
# DebianAdapter, UbuntuAdapter, FedoraAdapter, ArchAdapter, ProxmoxAdapter)
# produces: a self-contained menuentry that loads a kernel/initrd extracted
# from the ISO ahead of time, with a cmdline that points the target OS's own
# init at the original ISO file for its root filesystem.

menuentry "Pending: Ubuntu 24.04.1 LTS installer" --id pending_boot {
    insmod ext2
    search --no-floppy --set=root --label PENSYS
    linux ($root)/boot/extracted/ubuntu-24-04-1/vmlinuz boot=casper iso-scan/filename=/images/ubuntu-24.04.1.iso quiet ---
    initrd ($root)/boot/extracted/ubuntu-24-04-1/initrd
}
