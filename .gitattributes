# Everything here is consumed by Linux: shell shebangs, live-build hooks and
# GRUB configs all break on CRLF ("bad interpreter: /bin/sh^M"). Force LF so a
# checkout on Windows still produces a working live system.
* text=auto eol=lf

*.sh          text eol=lf
*.cfg         text eol=lf
*.service     text eol=lf
*.py          text eol=lf
*.list.chroot text eol=lf
*.hook.chroot text eol=lf
live/auto/config text eol=lf
Makefile      text eol=lf

*.png  binary
*.jpg  binary
*.iso  binary
*.zst  binary
*.squashfs binary
