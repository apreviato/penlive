#!/bin/sh
# systemd units are copied in via includes.chroot; enabling them here is what
# makes the manager come up automatically on boot.
set -e

systemctl enable NetworkManager.service
systemctl enable penlive-daemon.service
systemctl enable penlive-aria2.service
systemctl enable penlive-api.service
systemctl enable penlive-kiosk.service

# No display manager: the kiosk unit starts X itself on tty1.
systemctl set-default multi-user.target
