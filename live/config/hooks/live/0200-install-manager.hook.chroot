#!/bin/sh
# Builds the manager's Python venv inside the chroot so the squashfs ships with
# dependencies already resolved — the live system must work with no network.
set -e

python3 -m venv /opt/penlive/venv
/opt/penlive/venv/bin/pip install --no-cache-dir --upgrade pip
/opt/penlive/venv/bin/pip install --no-cache-dir -r /opt/penlive/backend/requirements.txt

chown -R penlive:penlive /opt/penlive/venv
