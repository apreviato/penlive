# Packages installed into the PenLive live system.
# One per line; live-build passes these to apt inside the chroot.

# --- init / base ---
systemd
systemd-sysv
dbus
# graphical boot splash, so the user sees a logo instead of kernel logs
plymouth
plymouth-themes

# --- network ---
network-manager
wpasupplicant
iw
wireless-tools
ca-certificates

# --- firmware (Wi-Fi on real laptops needs these; pulls from the non-free-firmware
# component enabled in auto/config) ---
firmware-linux
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211

# --- downloads ---
aria2
curl
wget

# --- manager runtime ---
python3
python3-venv
python3-pip

# --- UI ---
xserver-xorg
xserver-xorg-video-all
xinit
openbox
chromium
fonts-dejavu-core
# hides the mouse pointer when idle in the kiosk
unclutter
# keyboard layout database that /api/keyboard/layouts reads
xkb-data
console-setup
keyboard-configuration

# --- ISO handling / boot ---
xorriso
p7zip-full
squashfs-tools
libarchive-tools
grub-efi-amd64-bin
# Secure Boot chain: Microsoft-signed shim plus Debian-signed GRUB, so the
# stick boots on machines that ship with Secure Boot enabled.
shim-signed
grub-efi-amd64-signed
# Machine owner key: lets PenLive counter-sign kernels extracted from other
# distributions' ISOs, which shim would otherwise refuse under Secure Boot.
sbsigntool
mokutil
grub-common
kexec-tools

# --- partitioning / filesystems (needed by write-usb and by the builder when
# run from a live session) ---
parted
gdisk
dosfstools
exfatprogs
e2fsprogs
ntfs-3g
cryptsetup

# --- virtualization ---
qemu-system-x86
qemu-utils
ovmf

# --- diagnostics / recovery ---
smartmontools
nvme-cli
hdparm
pciutils
usbutils
iproute2
iputils-ping
less
nano

# --- tools/plugins (see docs/PLUGINS.md) ---
# backup + restore: filesystem-aware imaging (copies only used blocks)
partclone
# file-recovery: photorec ships in the testdisk package
testdisk
# provisioning + general file work
rsync
# disk-repair: btrfs/xfs checkers alongside the ext/ntfs/fat ones already listed
btrfs-progs
xfsprogs
# linux-repair: chroot lives in coreutils, but grub tooling must exist to
# reinstall a bootloader into the mounted system
grub2-common
# windows-repair: ntfsfix ships in ntfs-3g (already listed above)
lvm2
mdadm
