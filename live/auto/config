#!/bin/sh
# live-build configuration. Run via `lb config` (see live/build.sh).
set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --archive-areas "main contrib non-free-firmware" \
    --architectures amd64 \
    --binary-images iso-hybrid \
    --debian-installer none \
    --bootappend-live "boot=live components quiet splash loglevel=3 rd.systemd.show_status=false vt.global_cursor_default=0 persistence persistence-encryption=none" \
    --linux-packages "linux-image" \
    --firmware-chroot true \
    --apt-recommends false \
    --memtest none \
    "${@}"
